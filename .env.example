# ─── LLM (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── MongoDB (Atlas or your own install — NOT Docker) ─────────
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

MONGODB_DB=philoagents
MONGODB_VECTOR_COLLECTION=body_knowledge
MONGODB_SESSIONS_COLLECTION=chat_sessions
MONGODB_VECTOR_INDEX=body_knowledge_vector

# ─── Embeddings / RAG ─────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_NUM_CANDIDATES=100
RAG_MIN_SCORE=0.35
RAG_VECTOR_SEARCH_ENABLED=true
RAG_FALLBACK_ENABLED=true

# Bounded memory / request safety
SESSION_HISTORY_LIMIT=12
SESSION_MAX_MESSAGES=80
MAX_WEBSOCKET_MESSAGE_CHARS=4000

# Groq generation
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=800
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ─── Backend (FastAPI) ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Optional LLMOps (Opik) ───────────────────────────────────
OPIK_API_KEY=
OPIK_PROJECT=bodyagents
